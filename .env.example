# GEMINI_API_KEY: Required only if AI integration is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL for the SATU DPBI portal.
APP_URL="http://localhost:3000"

# DEMO_MODE: Production default MUST be false.
# Set to true only in isolated staging/preview environments with demo database.
DEMO_MODE="false"

# SESSION_SECRET: Cryptographic secret for signing session tokens (set strong random string in production).
SESSION_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_64_CHARS"

# STORAGE_QUOTA_MB: Storage threshold for Storage Control Center (default 10240 MB / 10 GB).
STORAGE_QUOTA_MB="10240"

# KEMENDIKDASMEN_INTEGRATION_ENABLED: Remains false until official API credentials & MoU exist.
KEMENDIKDASMEN_INTEGRATION_ENABLED="false"

# VITE_API_BASE_URL: Kosongkan jika frontend & backend berjalan satu domain.
# Isi dengan URL API backend (mis. "https://api.dpbi.or.id") jika frontend di-deploy terpisah di Vercel.
VITE_API_BASE_URL=""

# CORS_ALLOWED_ORIGINS: Daftar domain frontend yang diizinkan mengirim cookie sesi (pisahkan dengan koma).
CORS_ALLOWED_ORIGINS="https://satu.dpbi.or.id"

# COOKIE_SAMESITE & COOKIE_DOMAIN: Gunakan "none" + ".dpbi.or.id" hanya saat frontend & backend berbeda subdomain HTTPS.
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# SMTP_* (Opsional): Jika diisi, Pusat Email & Pengiriman Massal mengirim email nyata via Nodemailer.
# Jika kosong, mode "sandbox_outbox" digunakan untuk antrean & verifikasi internal tanpa mengirim email eksternal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SATU DPBI <noreply@dpbi.or.id>"
EMAIL_BATCH_LIMIT="250"
EMAIL_RATE_PER_MIN="60"

